    "test:types": "tsc --project test/typescript/tsconfig.valid.json && node test/typescript/assert-invalid.mjs"
  },
  "devDependencies": {
    "@hotwired/turbo": "^8.0.23",
    "@playwright/test": "^1.63.0",
    "@rails/actioncable": "^7.2.302",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
